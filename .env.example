# EmlaLock AI Discord Bot - local environment configuration
# 1. Copy this file to `.env` in the project root (never commit `.env`), OR run `python setup.py` for the guided local wizard.
# 2. Fill in required values below.
# 3. Start the bot with `python main.py` and use `/link` in Discord for per-user EmlaLock credentials.

## Discord (required)
DISCORD_TOKEN=

## OpenAI (required)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

## Local storage & security (required)
DATABASE_PATH=data/bot.sqlite3
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

## EmlaLock API
EMLALOCK_API_BASE_URL=https://api.emlalock.com

## Logging
LOG_LEVEL=INFO
